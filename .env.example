# Environment Variables Example
# Copy this file to .env.local and fill in the values

# ============================================
# AUTHENTICATION (Clerk)
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ============================================
# PAYMENT - STRIPE (International)
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# PAYMENT - CMI (Morocco)
# ============================================
CMI_MERCHANT_ID=
CMI_API_KEY=
CMI_SECRET_KEY=
CMI_GATEWAY_URL=https://cmigw.asseco.com.tr/PaymentGateway/Hosting/Default
CMI_CALLBACK_URL=

# ============================================
# SUPABASE (Optional - for vector embeddings)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/communium

# ============================================
# CACHE & SESSIONS (Redis)
# ============================================
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# AI SERVICE
# ============================================
AI_SERVICE_URL=http://localhost:8000

# ============================================
# FRONTEND & BACKEND URLs
# ============================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
BACKEND_INTERNAL_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# ============================================
# SECURITY
# ============================================
JWT_SECRET=your-jwt-secret-key-change-in-production
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
API_KEY=your-api-key-for-external-services
ENCRYPTION_KEY=replace-with-a-32-byte-secret
CAPTCHA_SECRET=
ADMIN_2FA_REQUIRED=true
CLERK_ADMIN_EMAILS=masinandrorasolonnjatovo@gmail.com
VERIFICATION_ADMIN_EMAILS=masinandrorasolonnjatovo@gmail.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# EMAIL / NOTIFICATIONS
# ============================================
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@communium.app
RESEND_API_KEY=

# ============================================
# STORAGE
# ============================================
STORAGE_PROVIDER=local
STORAGE_BUCKET=
